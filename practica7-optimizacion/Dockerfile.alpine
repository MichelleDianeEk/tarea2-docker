# Utilizar la versión Alpine de Python 3.12 como imagen base.
FROM python:3.12-alpine

# Crear y establecer /app como directorio de trabajo dentro del contenedor.
WORKDIR /app

# Copiar requirements.txt desde la carpeta del proyecto hacia /app dentro de la imagen.
COPY requirements.txt .

# Instalar las dependencias indicadas en requirements.txt sin conservar la caché de pip.
RUN pip install --no-cache-dir -r requirements.txt

# Copiar script.py desde la carpeta del proyecto hacia /app dentro de la imagen.
COPY script.py .

# Copiar data.csv desde la carpeta del proyecto hacia /app dentro de la imagen.
COPY data.csv .

# Ejecutar script.py automáticamente cuando se inicie el contenedor.
CMD ["python", "script.py"]
